# https://docs.npmjs.com/cli/v12/using-npm/config
# https://docs.npmjs.com/cli/v12/using-npm/changelog
# https://github.com/npm/cli/releases
#  https://github.com/npm/cli/releases/tag/v12.0.0

install-strategy = linked
strict-peer-deps = true
save-prefix = ~

############################################################
######################### SECURITY #########################
############################################################

# Don not run any lifecycle (pre/post/prepare and etc.)
# scripts. This includes scripts placed in root
# `package.json` file too.
ignore-scripts = true

# TODO: separate default permissions and permissions used
#  for different scripts (like `dev`). Can be done via
#  cross-env or maybe use ${PERMISSIONS?} replacement?
#
# This will disable any fs writes, network access, process
#  spawning and rtc. Only allows to read files in cwd. Works
#  for all postinstall and preinstall scripts too.
#
# Use `--permission-audit` for checking permission problems.
node-options = "--permission --allow-fs-read=* --allow-fs-write=* --allow-addons --allow-net --allow-child-process"

# Turn the install-script policy from a warning into a hard
#  error: any dependency with install scripts that is not
#  covered by allowScripts will fail the install instead of
#  being blocked with a warning.
strict-allow-scripts = true

# Do not install packages younger then 1 day
min-release-age = 1

# Only the named package is exempt; its own dependencies
#  still follow the release-age policy unless they also
#  match a pattern.
min-release-age-exclude[] = @(67)/*

# Do not install dependencies from local directories.
allow-directory = root

# Do not install dependencies from local tarball files.
allow-file = root

# Do not fetch dependencies from git references.
allow-git = root

# Do not fetch dependencies from urls.
allow-remote = root

############################################################
############################################################
############################################################
