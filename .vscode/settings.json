{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
    // "source.fixAll.stylelint": "always"
    // "source.fixAll.prettier": "always"
  },

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    // https://docs.npmjs.com/cli/v6/configuring-npm/npmrc
    //  "All npm config files are an ini-formatted list of key = value parameters"
    ".npmrc": "ini"
  },

  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  "json.schemaDownload.trustedDomains": {
    "https://nodejs.org/docs/": true,
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/": true
  },

  "npm.scriptRunner": "npm",

  "prettier.enable": true,
  "prettier.useEditorConfig": false,

  "eslint.enable": true,
  "eslint.format.enable": true,
  "eslint.runtime": "node",
  "eslint.options": {
    "flags": ["unstable_native_nodejs_ts_config"]
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // https://microsoft.github.io/vscode-codicons/dist/codicon.html
  "statusbar_command.commands": [
    // {
    //   "id": "custom:run-task",
    //   "text": "$(new-file) Doodle",
    //   "tooltip": "Select and run task",
    //   "alignment": "right",
    //   "command": "workbench.action.tasks.runTask",
    //   "color": "#14d243",
    //   "priority": 1000,
    // }

    {
      "id": "custom:run-task",
      "text": "$(play) Run Task",
      "tooltip": "Select and run task",
      "alignment": "right",
      "command": "workbench.action.tasks.runTask",
      "color": "#e80e44",
      "priority": 1000
    }
  ]
}
